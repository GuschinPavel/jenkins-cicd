pipeline {
    agent any
    triggers {
        upstream(upstreamProjects: 'Job_2', threshold: hudson.model.Result.SUCCESS)
    }
    stages {
        stage('Push Changes Back to Git') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-pat', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                        cd /var/jenkins_home/shared_storage
                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@example.com"
                        
                        if [ -n "$(git status --porcelain)" ]; then
                            git add -A
                            git commit -m "ci: remove file1.txt and file2.txt via Job_3 [skip ci]"
                        fi
                        
                        # Принудительно задаем правильный URL и пушим (даже если коммит уже был создан на прошлом упавшем прогоне)
                        git remote set-url origin "https://${GIT_USER}:${GIT_TOKEN}@://github.com"
                        git push origin HEAD:main
                    '''
                }
            }
        }
    }
}
